# SPDX-License-Identifier: GPL-2.0
# tissot (msm8953) device fragment: legacy ION + QSEECOM chardevs.
# Merged over gki_defconfig via merge_config.sh (same flow as the
# tissot-fedora.config build fragment). gki_defconfig itself stays clean.
# Built-in (=y, not =m): vendor.qseecomd starts at post-fs before vendor
# modules load. CONFIG_DMABUF_HEAPS / CONFIG_QCOM_SCM come from the base;
# they are required here (QSEECOM needs QCOM_SCM) — do not drop them.
CONFIG_ION=y
CONFIG_ION_LEGACY=y
CONFIG_ION_SYSTEM_HEAP=y
CONFIG_ION_CMA_HEAP=y
CONFIG_QSEECOM=y

# Qualcomm diag char driver (drivers/char/diag) + DIAG USB gadget function.
# Built-in: dpmd is an init-started service and needs /dev/diag before any
# vendor module load. DIAG_OVER_USB matches the donor msm8953-perf_defconfig.
CONFIG_DIAG_CHAR=y
CONFIG_DIAG_OVER_USB=y
CONFIG_USB_CONFIGFS_F_DIAG=y
