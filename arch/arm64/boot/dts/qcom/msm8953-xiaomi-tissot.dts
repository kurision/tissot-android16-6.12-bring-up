/dts-v1/;

#include "msm8953.dtsi"
#include "pm8953.dtsi"
#include "pmi8950.dtsi"
#include "msm8953-xiaomi-tissot-audio.dtsi"
#include "msm8953-xiaomi-tissot-battery.dtsi"
#include "msm8953-xiaomi-tissot-camera.dtsi"
#include "msm8953-xiaomi-tissot-fingerprint.dtsi"
#include "msm8953-xiaomi-tissot-mdss.dtsi"
#include "msm8953-xiaomi-tissot-vidc.dtsi"
#include "msm8953-xiaomi-tissot-thermal.dtsi"
#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/linux-event-codes.h>

/delete-node/ &adsp_fw_mem;
/delete-node/ &qseecom_mem;
/delete-node/ &wcnss_fw_mem;

/ {
	model = "Xiaomi Mi A1";
	compatible = "xiaomi,tissot", "qcom,msm8953";
	chassis-type = "handset";
	qcom,msm-id = <293 0>;
	qcom,board-id = <0x1000b 0x00>;

	aliases {
		mmc0 = &sdhc_1;
		mmc1 = &sdhc_2;
	};

	cpus {
		idle-states {
			entry-method = "psci";

			/* Core-only states and timings from CAF msm8953-pm.dtsi. */
			tissot_cpu_sleep_0: cpu-sleep-0 {
				compatible = "arm,idle-state";
				idle-state-name = "standalone-power-collapse";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <136>;
				exit-latency-us = <180>;
				min-residency-us = <901>;
				local-timer-stop;
			};

			tissot_cpu_sleep_1: cpu-sleep-1 {
				compatible = "arm,idle-state";
				idle-state-name = "standalone-power-collapse";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <179>;
				exit-latency-us = <362>;
				min-residency-us = <401>;
				local-timer-stop;
			};
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&gpio_key_default>, <&gpio_hall_sensor_default>;

		event-hall-sensor {
			label = "Hall Effect Sensor";
			gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			linux,can-disable;
		};

		key-volume-up {
			label = "Volume Up";
			gpios = <&tlmm 85 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};
	};

	ion {
		compatible = "qcom,msm-ion";
		#address-cells = <1>;
		#size-cells = <0>;

		heap@1b {
			reg = <27>;
			memory-region = <&qseecom_mem>;
			qcom,ion-heap-type = "DMA";
		};

		heap@13 {
			reg = <19>;
			memory-region = <&qseecom_ta_mem>;
			qcom,ion-heap-type = "DMA";
		};

		heap@19 {
			reg = <25>;
			qcom,ion-heap-type = "SYSTEM";
		};
	};

	reserved-memory {
		/* 0x84a00000 is other_ext_region (secure-app loading window owned
		 * by TrustZone), not the shared DMA pool. Kept no-map and kept at
		 * 0x1900000: stock's 0x1e00000 would overlap smem@86300000 and
		 * ramoops@86800000 in this layout. Renamed to end the confusion
		 * with the qseecom shared pools below.
		 */
		other_ext_region: other_ext_region@84a00000 {
			reg = <0x0 0x84a00000 0x0 0x1900000>;
			no-map;
		};

		/* TZ-shared pools, values read off the stock live device-tree.
		 * Heap 27 (QSEECOM, 40KB keymaster buffers) and heap 19 (TA heap)
		 * must allocate here: TrustZone XPU rejects secure-command buffers
		 * outside the carveout (snapshot30 resets). Without memory-region
		 * the msm ION driver leaves base/size zero and the heap falls back
		 * to generic CMA: boot logs "ION heap qsecom created" with no
		 * address. With it, expect "created at <addr>".
		 */
		qseecom_mem: qseecom_region@0 {
			compatible = "shared-dma-pool";
			reusable;
			alignment = <0x0 0x400000>;
			size = <0x0 0x1000000>;
		};

		qseecom_ta_mem: qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
			reusable;
			alignment = <0x0 0x400000>;
			size = <0x0 0x800000>;
		};

		adsp_fw_mem: adsp@8d600000 {
			reg = <0x0 0x8d600000 0x0 0x1200000>;
			no-map;
		};

		wcnss_fw_mem: wcnss@8e800000 {
			reg = <0x0 0x8e800000 0x0 0x700000>;
			no-map;
		};

		/* ACK's original ramoops@9ff00000 is not reproduced: accessing that
		 * address aborts the CPU on this phone. 0x86800000 is a 4 MiB System
		 * RAM hole (iomem reports 86800000-86bfffff) between
		 * reserved@86400000 and mpss@86c00000 that nothing else claims.
		 */
		ramoops@86800000 {
			compatible = "ramoops";
			reg = <0x0 0x86800000 0x0 0x00100000>;
			record-size = <0x1000>;
			console-size = <0x80000>;
			ftrace-size = <0x1000>;
			pmsg-size = <0x8000>;
			/* Include genuine emergency and orderly-shutdown dumps. */
			max-reason = <4>;
		};
	};
	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-always-on;
		regulator-boot-on;
	};
};

/* Attach the TZ-shared carveout to the qseecom device: every
 * dma_alloc_coherent on it (tzbuf, SMC >4-arg spill buffers) then comes
 * from memory TrustZone is allowed to read. Without this they fall back
 * to generic memory and the first TA data transaction wedges silently.
 */
&qcom_seecom {
	memory-region = <&qseecom_mem>;
};

&hsusb_phy {
	vdd-supply = <&pm8953_l3>;
	vdda-pll-supply = <&pm8953_l7>;
	vdda-phy-dpdm-supply = <&pm8953_l13>;

	status = "okay";
};

&i2c_2 {
	status = "okay";

	max98927_codec: audio-codec@3a {
		compatible = "maxim,max98927";
		reg = <0x3a>;

		reset-gpios = <&tlmm 86 GPIO_ACTIVE_LOW>;

		vmon-slot-no = <1>;
		imon-slot-no = <1>;

		#sound-dai-cells = <0>;
	};

	led-controller@45 {
		compatible = "awinic,aw2013";
		reg = <0x45>;

		vcc-supply = <&pm8953_l10>;
		vio-supply = <&pm8953_l5>;

		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			led-max-microamp = <5000>;
			function = LED_FUNCTION_INDICATOR;
			color = <LED_COLOR_ID_WHITE>;
		};
	};
};

&i2c_3 {
	status = "okay";

	touchscreen@38 {
		compatible = "edt,edt-ft5406";
		reg = <0x38>;

		interrupt-parent = <&tlmm>;
		interrupts = <65 IRQ_TYPE_EDGE_FALLING>;

		pinctrl-names = "default";
		pinctrl-0 = <&ts_int_default &ts_reset_default>;

		reset-gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;

		vcc-supply = <&pm8953_l10>;
		iovcc-supply = <&pm8953_l6>;
		edt,gesture-wakeup;

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <1920>;

		/*
		 * Capacitive navigation keys, reported by the controller as
		 * touches on the sensor row below the panel, so the
		 * coordinates are the controller's and not the panel's.
		 *
		 * The x positions are the stock ones: 500 is the home key
		 * in the middle, 800 is back on the right, and 200 is the
		 * recents on the left, which is where this phone puts it.
		 *
		 * The codes are the ones this ROM's own key layout names.
		 * The framework translates the kernel's key code through
		 * /system/usr/keylayout/Generic.kl, and that file maps
		 * 172 to HOME, 158 to BACK and 580 to APP_SWITCH. The
		 * donor's focaltech_ts node describes a board with a
		 * Focaltech touch controller and gives the recents key
		 * KEY_MENU, which that layout maps to MENU - the overflow
		 * menu, not the recents. 580 is KEY_APPSELECT in the
		 * kernel.
		 */
		edt,keys = <500 2040 KEY_HOMEPAGE
			    200 2040 KEY_APPSELECT
			    800 2040 KEY_BACK>;
	};
};

&pm8953_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

&pmi8950_wled {
	qcom,num-strings = <2>;
	qcom,current-limit-microamp = <20000>;
	qcom,external-pfet;
	qcom,cabc;

	status = "okay";
};

&rpm_requests {
	regulators {
		compatible = "qcom,rpm-pm8953-regulators";

		vdd_s1-supply = <&vph_pwr>;
		vdd_s2-supply = <&vph_pwr>;
		vdd_s3-supply = <&vph_pwr>;
		vdd_s4-supply = <&vph_pwr>;
		vdd_s5-supply = <&vph_pwr>;
		vdd_s6-supply = <&vph_pwr>;
		vdd_s7-supply = <&vph_pwr>;
		vdd_l1-supply = <&pm8953_s3>;
		vdd_l2_l3-supply = <&pm8953_s3>;
		vdd_l4_l5_l6_l7_l16_l19-supply = <&pm8953_s4>;
		vdd_l8_l11_l12_l13_l14_l15-supply = <&vph_pwr>;
		vdd_l9_l10_l17_l18_l22-supply = <&vph_pwr>;

		pm8953_s1: s1 {
			regulator-min-microvolt = <870000>;
			regulator-max-microvolt = <1156000>;
		};

		pm8953_s3: s3 {
			regulator-min-microvolt = <1224000>;
			regulator-max-microvolt = <1224000>;
		};

		pm8953_s4: s4 {
			regulator-min-microvolt = <1900000>;
			regulator-max-microvolt = <2050000>;
		};

		pm8953_l1: l1 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1000000>;
		};

		pm8953_l2: l2 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1225000>;
		};

		pm8953_l3: l3 {
			regulator-min-microvolt = <925000>;
			regulator-max-microvolt = <925000>;
		};

		pm8953_l5: l5 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8953_l6: l6 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8953_l7: l7 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1900000>;
		};

		pm8953_l8: l8 {
			regulator-min-microvolt = <2900000>;
			regulator-max-microvolt = <2900000>;
		};

		pm8953_l9: l9 {
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
		};

		pm8953_l10:l10 {
			regulator-min-microvolt = <2850000>;
			regulator-max-microvolt = <2850000>;
		};

		pm8953_l11: l11 {
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2950000>;
		};

		pm8953_l12: l12 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <2950000>;
		};

		pm8953_l13: l13 {
			regulator-min-microvolt = <3125000>;
			regulator-max-microvolt = <3125000>;
		};

		pm8953_l16: l16 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8953_l17: l17 {
			regulator-min-microvolt = <2750000>;
			regulator-max-microvolt = <2850000>;
		};

		pm8953_l19: l19 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1350000>;
		};

		pm8953_l22: l22 {
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
		};

		pm8953_l23: l23 {
			regulator-min-microvolt = <1200000>;
