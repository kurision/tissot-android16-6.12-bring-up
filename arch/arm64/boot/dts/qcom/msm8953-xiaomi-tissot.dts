/dts-v1/;

#include "msm8953.dtsi"
#include "pm8953.dtsi"
#include "pmi8950.dtsi"
#include "msm8953-xiaomi-tissot-mdss.dtsi"
#include <dt-bindings/leds/common.h>

/delete-node/ &adsp_fw_mem;
/delete-node/ &qseecom_mem;
/delete-node/ &wcnss_fw_mem;

/ {
	model = "Xiaomi Mi A1";
	compatible = "xiaomi,tissot", "qcom,msm8953";
	chassis-type = "handset";
	qcom,msm-id = <293 0>;
	qcom,board-id = <0x1000b 0x00>;

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&gpio_key_default>, <&gpio_hall_sensor_default>;

		event-hall-sensor {
			label = "Hall Effect Sensor";
			gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			linux,can-disable;
		};

		key-volume-up {
			label = "Volume Up";
			gpios = <&tlmm 85 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};
	};

	ion {
		compatible = "qcom,msm-ion";
		#address-cells = <1>;
		#size-cells = <0>;

		heap@1b {
			reg = <27>;
			memory-region = <&qseecom_mem>;
			qcom,ion-heap-type = "DMA";
		};

		heap@13 {
			reg = <19>;
			memory-region = <&qseecom_ta_mem>;
			qcom,ion-heap-type = "DMA";
		};

		heap@19 {
			reg = <25>;
			qcom,ion-heap-type = "SYSTEM";
		};
	};

	reserved-memory {
		/* 0x84a00000 is other_ext_region (secure-app loading window owned
		 * by TrustZone), not the shared DMA pool. Kept no-map and kept at
		 * 0x1900000: stock's 0x1e00000 would overlap smem@86300000 and
		 * ramoops@86800000 in this layout. Renamed to end the confusion
		 * with the qseecom shared pools below.
		 */
		other_ext_region: other_ext_region@84a00000 {
			reg = <0x0 0x84a00000 0x0 0x1900000>;
			no-map;
		};

		/* TZ-shared pools, values read off the stock live device-tree.
		 * Heap 27 (QSEECOM, 40KB keymaster buffers) and heap 19 (TA heap)
		 * must allocate here: TrustZone XPU rejects secure-command buffers
		 * outside the carveout (snapshot30 resets). Without memory-region
		 * the msm ION driver leaves base/size zero and the heap falls back
		 * to generic CMA: boot logs "ION heap qsecom created" with no
		 * address. With it, expect "created at <addr>".
		 */
		qseecom_mem: qseecom_region@0 {
			compatible = "shared-dma-pool";
			reusable;
			alignment = <0x0 0x400000>;
			size = <0x0 0x1000000>;
		};

		qseecom_ta_mem: qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
			reusable;
			alignment = <0x0 0x400000>;
			size = <0x0 0x800000>;
		};

		adsp_fw_mem: adsp@8d600000 {
			reg = <0x0 0x8d600000 0x0 0x1200000>;
			no-map;
		};

		wcnss_fw_mem: wcnss@8e800000 {
			reg = <0x0 0x8e800000 0x0 0x700000>;
			no-map;
		};

		/* ACK's original ramoops@9ff00000 is not reproduced: accessing that
		 * address aborts the CPU on this phone. 0x86800000 is a 4 MiB System
		 * RAM hole (iomem reports 86800000-86bfffff) between
		 * reserved@86400000 and mpss@86c00000 that nothing else claims.
		 */
		ramoops@86800000 {
			compatible = "ramoops";
			reg = <0x0 0x86800000 0x0 0x00100000>;
			record-size = <0x1000>;
			console-size = <0x80000>;
			ftrace-size = <0x1000>;
			pmsg-size = <0x8000>;
		};
	};
	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-always-on;
		regulator-boot-on;
	};
};

/* Attach the TZ-shared carveout to the qseecom device: every
 * dma_alloc_coherent on it (tzbuf, SMC >4-arg spill buffers) then comes
 * from memory TrustZone is allowed to read. Without this they fall back
 * to generic memory and the first TA data transaction wedges silently.
 */
&qcom_seecom {
	memory-region = <&qseecom_mem>;
};

&hsusb_phy {
	vdd-supply = <&pm8953_l3>;
	vdda-pll-supply = <&pm8953_l7>;
	vdda-phy-dpdm-supply = <&pm8953_l13>;

	status = "okay";
};

&i2c_2 {
	status = "okay";

	max98927_codec: audio-codec@3a {
		compatible = "maxim,max98927";
		reg = <0x3a>;

		reset-gpios = <&tlmm 86 GPIO_ACTIVE_LOW>;

		vmon-slot-no = <1>;
		imon-slot-no = <1>;

		#sound-dai-cells = <0>;
	};

	led-controller@45 {
		compatible = "awinic,aw2013";
		reg = <0x45>;

		vcc-supply = <&pm8953_l10>;
		vio-supply = <&pm8953_l5>;

		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			led-max-microamp = <5000>;
			function = LED_FUNCTION_INDICATOR;
			color = <LED_COLOR_ID_WHITE>;
		};
	};
};

&i2c_3 {
	status = "okay";

	touchscreen@38 {
		compatible = "edt,edt-ft5406";
		reg = <0x38>;

		interrupt-parent = <&tlmm>;
		interrupts = <65 IRQ_TYPE_EDGE_FALLING>;

		pinctrl-names = "default";
		pinctrl-0 = <&ts_int_default &ts_reset_default>;

		reset-gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;

		vcc-supply = <&pm8953_l10>;
		iovcc-supply = <&pm8953_l6>;

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <1920>;
	};
};

&pm8953_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

&pmi8950_wled {
	qcom,num-strings = <2>;
	qcom,external-pfet;
	qcom,cabc;

	status = "okay";
};

&rpm_requests {
	regulators {
		compatible = "qcom,rpm-pm8953-regulators";

		vdd_s1-supply = <&vph_pwr>;
		vdd_s2-supply = <&vph_pwr>;
		vdd_s3-supply = <&vph_pwr>;
		vdd_s4-supply = <&vph_pwr>;
		vdd_s5-supply = <&vph_pwr>;
		vdd_s6-supply = <&vph_pwr>;
		vdd_s7-supply = <&vph_pwr>;
		vdd_l1-supply = <&pm8953_s3>;
		vdd_l2_l3-supply = <&pm8953_s3>;
		vdd_l4_l5_l6_l7_l16_l19-supply = <&pm8953_s4>;
		vdd_l8_l11_l12_l13_l14_l15-supply = <&vph_pwr>;
		vdd_l9_l10_l17_l18_l22-supply = <&vph_pwr>;

		pm8953_s1: s1 {
			regulator-min-microvolt = <870000>;
			regulator-max-microvolt = <1156000>;
		};

		pm8953_s3: s3 {
			regulator-min-microvolt = <1224000>;
			regulator-max-microvolt = <1224000>;
		};

		pm8953_s4: s4 {
			regulator-min-microvolt = <1900000>;
			regulator-max-microvolt = <2050000>;
		};

		pm8953_l1: l1 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1000000>;
		};

		pm8953_l2: l2 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1225000>;
		};

		pm8953_l3: l3 {
			regulator-min-microvolt = <925000>;
			regulator-max-microvolt = <925000>;
		};

		pm8953_l5: l5 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8953_l6: l6 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8953_l7: l7 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1900000>;
		};

		pm8953_l8: l8 {
			regulator-min-microvolt = <2900000>;
			regulator-max-microvolt = <2900000>;
		};

		pm8953_l9: l9 {
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
		};

		pm8953_l10:l10 {
			regulator-min-microvolt = <2850000>;
			regulator-max-microvolt = <2850000>;
		};

		pm8953_l11: l11 {
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2950000>;
		};

		pm8953_l12: l12 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <2950000>;
		};

		pm8953_l13: l13 {
			regulator-min-microvolt = <3125000>;
			regulator-max-microvolt = <3125000>;
		};

		pm8953_l16: l16 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8953_l17: l17 {
			regulator-min-microvolt = <2750000>;
			regulator-max-microvolt = <2850000>;
		};

		pm8953_l19: l19 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1350000>;
		};

		pm8953_l22: l22 {
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
		};

		pm8953_l23: l23 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1225000>;
		};
	};
};

&sdhc_1 {
	vmmc-supply = <&pm8953_l8>;
	vqmmc-supply = <&pm8953_l5>;

	status = "okay";
};

&sdhc_2 {
	vmmc-supply = <&pm8953_l11>;
	vqmmc-supply = <&pm8953_l12>;

	cd-gpios = <&tlmm 133 GPIO_ACTIVE_HIGH>;

	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc2_clk_on &sdc2_cmd_on &sdc2_data_on &sdc2_cd_on>;
	pinctrl-1 = <&sdc2_clk_off &sdc2_cmd_off &sdc2_data_off &sdc2_cd_off>;

	status = "okay";
};

&tlmm {
	gpio-reserved-ranges = <0 4>, <16 4>, <135 4>;

	gpio_hall_sensor_default: gpio-hall-sensor-state {
		pins = "gpio44";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	ts_int_default: ts-int-default-state {
		pins = "gpio65";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	ts_reset_default: ts-reset-default-state {
		pins = "gpio64";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};
};

&uart_0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart_console_active>;

	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb3_dwc3 {
	/delete-property/ usb-role-switch;
	dr_mode = "peripheral";
};

&mdss {
	status = "disabled";
};

&mdss_dsi0 {
	status = "disabled";
};

&mdss_dsi1 {
	status = "disabled";
};

&mdss_dsi0_phy {
	status = "disabled";
};

&mdss_dsi1_phy {
	status = "disabled";
};

&lpass {
	status = "okay";

	smd-edge {
		/*
		 * FastRPC compute channel (mirrors msm8996.dtsi): label
		 * must match the ADSP domain; no cb children (no LPASS
		 * SMMU on 8953). Creates /dev/adsprpc-smdX once ADSP
		 * announces the channel.
		 */
		fastrpc {
			compatible = "qcom,fastrpc";
			qcom,smd-channels = "fastrpcsmd-apps-dsp";
			label = "adsp";
			qcom,non-secure-domain;
		};
	};
};

&gpu {
	compatible = "qcom,kgsl-3d0", "qcom,adreno-506.0";
	status = "okay";
	/*
	 * Vendor chip identity, from the 4.19 donor gpu node
	 * (msm8953-gpu.dtsi:109, qcom,chipid = <0x05000600> = A506 rev 6.0.0).
	 * 6.12's msm8953.dtsi gpu node dropped it (drm/msm probes the chip from
	 * hardware), but adreno_update_soc_hw_revision_quirks() reads only the DT
	 * and BUG()s in probe without it (adreno.c:838-843) — an invisible reset
	 * with oops=panic + console=ttynull.
	 */
	qcom,chipid = <0x05000600>;

	/*
	 * Vendor identity/IO properties, from the 4.19 donor gpu node
	 * (msm8953-gpu.dtsi:101-113). adreno_of_get_power() returns -EINVAL
	 * without `label` (adreno.c:1215-1218, "(NULL device *): Unable to
	 * read 'label'") and without `qcom,id` (adreno.c:1220).
	 */
	label = "kgsl-3d0";
	qcom,id = <0>;
	qcom,initial-pwrlevel = <0>;
	qcom,idle-timeout = <80>; /* msecs */

	/*
	 * GPU memory addressing bank bit, verbatim from the 4.19 donor gpu node
	 * (msm8953-gpu.dtsi:117). Without it of_property_read_u32() leaves
	 * adreno_dev->highest_bank_bit at 0, and a5xx_init() WARNs
	 * ("The highest-bank-bit property is invalid", adreno_a5xx.c:294) and
	 * clamps it to 13 instead of the correct 14 — a wrong memory-addressing
	 * parameter, not just a warning. seen in run29.
	 */
	qcom,highest-bank-bit = <14>;

	/*
	 * Donor GPU clock names, verbatim from the 4.19 gpu node
	 * (msm8953-gpu.dtsi:128-130). _get_clocks() matches DT clock-names
	 * against the driver's table (kgsl_pwrctrl.c:37-56) and skips every
	 * name it does not know, so the 6.12 names ("core", "iface",
	 * "mem_iface", ...) matched nothing: not one GPU clock was ever
	 * acquired and nothing reported it. The clocks phandle list is
	 * inherited unchanged from msm8953.dtsi:1054-1059, so these names
	 * map onto the same six clocks in the same order.
	 */
	clock-names = "core_clk", "iface_clk",
		      "mem_iface_clk", "alt_mem_iface_clk",
		      "rbbmtimer_clk", "alwayson_clk";

	/*
	 * Donor IRQ name (msm8953-gpu.dtsi). kgsl_request_irq() looks the IRQ
	 * up by name ("kgsl_3d0_irq", adreno.c:53 -> kgsl.c:5368); the 6.12
	 * node has only `interrupts`, so probe failed with -ENXIO — run26.
	 */
	interrupt-names = "kgsl_3d0_irq";

	/*
	 * Vendor legacy bus-vote table, verbatim from the 4.19 donor gpu node
	 * (msm8953-gpu.dtsi:135-149). kgsl_get_bus_scale_table() (kgsl.c:1390)
	 * looks for a "qcom,gpu-bus-table[-ddrN]" child, then falls back to
	 * msm_bus_cl_get_pdata(), which parses the vendor legacy
	 * "qcom,msm-bus,*" properties off the gpu node itself. Neither the
	 * child node nor these properties existed here, so all three lookups
	 * returned NULL and kgsl_pwrctrl_init() bailed out with -EINVAL on its
	 * very first statement (kgsl_pwrctrl.c:2267-2269) — run25.
	 * msm-bus-compat.c reads exactly this format.
	 *
	 * Deliberately NOT ported: qcom,bus-control + qcom,gpubw-dev. The
	 * donor's "qcom,devbw" gpubw node matches no 6.12 OF bus, so
	 * of_find_device_by_node() would return NULL and the driver would
	 * skip msm_bus_scale_register_client() entirely, silently dropping
	 * every bus vote. Without those properties the driver registers the
	 * client itself against the "gpu_icc_path" interconnect; this gpu node
	 * has no "interconnects" property, so votes are accepted and warned
	 * about once rather than applied.
	 *
	 * 11 cases cover every bus index the pwrlevels below use (0-10).
	 */
	qcom,msm-bus,name = "grp3d";
	qcom,msm-bus,num-cases = <11>;
	qcom,msm-bus,num-paths = <1>;
	qcom,msm-bus,vectors-KBps =
			<26 512 0 0>,	     /*  off          */
			<26 512 0 1689600>, /* 1. 211.20 MHz */
			<26 512 0 2227200>, /* 2. 278.40 MHz */
			<26 512 0 3072000>, /* 3. 384.00 MHz */
			<26 512 0 3379200>, /* 4.  422.40 MHz */
			<26 512 0 4454400>, /* 5. 556.80 MHz */
			<26 512 0 5376000>, /* 6. 672.00 MHz */
			<26 512 0 6144000>, /* 7. 768.00 MHz */
			<26 512 0 6451200>, /* 8. 806.40 MHz */
			<26 512 0 6758400>, /* 9. 844.80 MHz */
			<26 512 0 7449600>; /*10. 931.20 MHz */

	/*
	 * Vendor legacy power levels, verbatim from the 4.19 donor gpu node
	 * (msm8953-gpu.dtsi:202-278, "qcom,gpu-pwrlevels"). The ported driver
	 * parses only these: adreno_of_get_pwrlevels() falls back to the legacy
	 * node and returns -EINVAL ("Unable to find 'qcom,gpu-pwrlevels'") when
	 * it is absent (adreno.c:1108-1114). The 6.12 tree's gpu node carries
	 * only the OPP-v2 table, which the driver never reads. Bus indices are
	 * the donor's; the msm-bus shim maps them onto the 6.12 interconnect.
	 */
	qcom,gpu-pwrlevels {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "qcom,gpu-pwrlevels";

		/* TURBO */
		qcom,gpu-pwrlevel@0 {
			reg = <0>;
			qcom,gpu-freq = <650000000>;
			qcom,bus-freq = <10>;
			qcom,bus-min = <10>;
			qcom,bus-max = <10>;
		};

		/* NOM+ */
		qcom,gpu-pwrlevel@1 {
			reg = <1>;
			qcom,gpu-freq = <560000000>;
			qcom,bus-freq = <10>;
			qcom,bus-min = <8>;
			qcom,bus-max = <10>;
		};

		/* NOM */
		qcom,gpu-pwrlevel@2 {
			reg = <2>;
			qcom,gpu-freq = <510000000>;
			qcom,bus-freq = <9>;
			qcom,bus-min = <6>;
			qcom,bus-max = <10>;
		};

		qcom,gpu-pwrlevel@3 {
			reg = <3>;
			qcom,gpu-freq = <400000000>;
			qcom,bus-freq = <7>;
			qcom,bus-min = <5>;
			qcom,bus-max = <8>;
		};

		/* SVS+ */
		qcom,gpu-pwrlevel@4 {
			reg = <4>;
			qcom,gpu-freq = <320000000>;
			qcom,bus-freq = <4>;
			qcom,bus-min = <2>;
			qcom,bus-max = <6>;
		};

		/* SVS */
		qcom,gpu-pwrlevel@5 {
			reg = <5>;
			qcom,gpu-freq = <216000000>;
			qcom,bus-freq = <1>;
			qcom,bus-min = <1>;
			qcom,bus-max = <4>;
		};

		/* Low SVS */
		qcom,gpu-pwrlevel@6 {
			reg = <6>;
			qcom,gpu-freq = <133300000>;
			qcom,bus-freq = <1>;
			qcom,bus-min = <1>;
			qcom,bus-max = <4>;
		};

		/* XO */
		qcom,gpu-pwrlevel@7 {
			reg = <7>;
			qcom,gpu-freq = <19200000>;
			qcom,bus-freq = <0>;
			qcom,bus-min = <0>;
			qcom,bus-max = <0>;
		};
	};

	/*
	 * Vendor kgsl-iommu glue from the 4.19 donor
	 * (kernel_xiaomi_msm8953 msm8953-gpu.dtsi, kgsl_msm_iommu node),
	 * retargeted to the 6.12 tree's gpu_iommu SMMU handle. Without it
	 * kgsl_iommu_probe finds no qcom,kgsl-smmu-v2 node and the driver
	 * cannot bring up its context bank.
	 */
	kgsl_iommu: qcom,kgsl-iommu@1c40000 {
		compatible = "qcom,kgsl-smmu-v2";
		reg = <0x01c40000 0x10000>;
		clocks = <&gcc GCC_OXILI_AHB_CLK>, <&gcc GCC_BIMC_GFX_CLK>;
		/*
		 * DO NOT "fix" these to the gpu node's clock-names.
		 *
		 * These names are read from THIS node but resolved by
		 * devm_clk_get() against the *gpu* device, because the
		 * kgsl-iommu node matches no 6.12 OF bus and so never gets a
		 * platform device of its own. They therefore do not resolve
		 * ("dt: Couldn't get clock: gpu_ahb_clk"), and _kgsl_iommu_probe
		 * returns -ENODEV there.
		 *
		 * That early return is load-bearing. Renaming them to the gpu
		 * node's names ("iface_clk"/"mem_iface_clk") does make the probe
		 * succeed, and the GPU then binds and works — but the phone dies
		 * ~60 s into the boot, before the diag init writes anything, twice
		 * in a row: run34 and run36. With the names left as they are,
		 * run35 boots to a full 300 s+ Android and /dev/kgsl-3d0 opens.
		 *
		 * kgsl_iommu_probe is a separate platform driver, so its -ENODEV
		 * is non-fatal to the GPU bind. The untested code past the early
		 * return (of_platform_populate over the CB children, and the
		 * NULL-pdev fallback passing the live GPU device to
		 * of_dma_configure(ctx->dev, node, true)) is what kills the
		 * boot; guarding the of_dma_configure call did not help (run36).
		 * Investigating that path needs its own evidence, not a guess.
		 */
		clock-names = "gpu_ahb_clk", "gcc_bimc_gfx_clk";
		qcom,secure_align_mask = <0xfff>;
		qcom,retention;
		qcom,global_pt;
		gfx3d_user: gfx3d_user {
			compatible = "qcom,smmu-kgsl-cb";
			label = "gfx3d_user";
			iommus = <&gpu_iommu 0>;
			qcom,iommu-dma = "disabled";
		};
	};
};

/* earlycon: stdout-path lets bare `earlycon` auto-match the UART (see
 * porting/REFERENCE-boot-testing.md — early console is the only channel
 * that catches a panic before level 2). */
&{/chosen} {
	stdout-path = "/soc@0/serial@78af000:115200n8";
};

/* WCN3680 (stock live DT iris compatible); supplies from the live DT:
 * vddxo=l7, vddrfa=l19, vddpa=l9, vdddig=l5. Blobs from the
 * modem-partition harvest (adsp.*+wcnss.*) plus vendor wlan/prima/. */
&wcnss {
	status = "okay";
};

&wcnss_iris {
	compatible = "qcom,wcn3680";
	vddxo-supply = <&pm8953_l7>;
	vddrfa-supply = <&pm8953_l19>;
	vddpa-supply = <&pm8953_l9>;
	vdddig-supply = <&pm8953_l5>;

	status = "okay";
};
