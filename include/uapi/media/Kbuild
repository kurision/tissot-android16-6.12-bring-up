# The CAF video codec (vidc_3x) user space interface.  The vendor OMX
# service of this ROM is 32 bit and compiles against these headers, so
# their contents are ABI and must stay numerically identical to the
# donor's.
header-y += msm_vidc.h
header-y += msm_media_info.h
header-y += msm_vidc_private.h
header-y += msm_vidc_utils.h
