# Xiaomi Mi A1 (tissot / MSM8953) device config for ACK android16-6.12
#
# Retargeted from android17-6.18 on 2026-10-04. 6.12 is the mature ACK line:
# it carries point releases through 2026-09 plus android16-6.12-lts, and its
# qcom_scm.c already publishes __scm before requesting the waitqueue irq
# (android16-6.12:2004-2006), which is the fix the 6.18 tree still lacks.
#
# Every symbol here was checked against the 6.12 tree's Kconfigs and the
# resolved .config. Six symbols carried over from the 6.18 file do not exist
# in 6.12 and have been removed (see below). Re-derive after any device-tree
# change with
#   scripts/ack-driver-audit.py --dtb <dtb> --tree <ack-tree> --config <out>/.config
#
# This is the "does it drive the board at all" set: PMIC, regulators, RPM clocks,
# RPM, storage, USB glue, serial, I2C/SPI, thermal, WWAN control, and the three
# on-board peripherals the board file enables (AW2013 LED, FT5406 touch, MAX98927 amp).

# Removed as nonexistent in android16-6.12 (verified against that tree's Kconfigs):
#   CONFIG_QCOM_UBWC_CONFIG, CONFIG_QCOM_RNG, CONFIG_PHY_MSM_QUSB_QMP,
#   CONFIG_QCOM_BT_LPM, CONFIG_QCOM_WCNSS_SMD, CONFIG_USB_CONFIGFS_RND
#
# This is the "does it drive the board at all" set: PMIC, regulators, RPM clocks,
# RPM, storage, USB glue, serial, I2C/SPI, thermal, WWAN control, and the three
# on-board peripherals the board file enables (AW2013 LED, FT5406 touch, MAX98927 amp).

# --- core Qualcomm infrastructure -------------------------------------------
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_QCOM_SMD_RPM=y
# COMMON_CLK_QCOM is a menuconfig (drivers/clk/qcom/Kconfig:10) wrapping every
# symbol in that file in "if COMMON_CLK_QCOM". Omitting it prunes the whole file
# with no Kconfig error, which is how every image booted so far lost
# MSM_GCC_8953 and PINCTRL_MSM8953.
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_QCOM_IOMMU=y
CONFIG_QCOM_BAM_DMA=y
# CONFIG_RPMSG_QCOM_SMD gates CONFIG_QCOM_SMD_RPM (depends on RPMSG_QCOM_SMD),
# which in turn gates CONFIG_QCOM_CLK_SMD_RPM. Leaving it out does not fail the
# merge: QCOM_SMD_RPM silently degrades and the RPM clock controller drops out
# with it, taking every RPM-governed clock with it.
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_RPMPD=y
CONFIG_MSM_GCC_8953=y
# PINCTRL_MSM is the matching master gate for pinctrl: Kconfig.msm wraps every
# Qualcomm pin controller in "if PINCTRL_MSM" (line 2 to end of file), so
# without it PINCTRL_MSM8953 below is pruned exactly the way MSM_GCC_8953 was.
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_MSM8953=y
CONFIG_POWER_RESET_MSM=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_INPUT_PM8941_PWRKEY=y

# --- PMIC, regulators, analog ----------------------------------------------
CONFIG_MFD_SPMI_PMIC=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_LABIBB=y
CONFIG_QCOM_SPMI_VADC=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_PHY_QCOM_QUSB2=y

# --- storage, serial, buses ------------------------------------------------
CONFIG_MMC_SDHCI_MSM=y
CONFIG_SERIAL_MSM=y
CONFIG_I2C_QUP=y
CONFIG_SPI_QUP=y

# --- audio DSP (LPASS / Q6) ------------------------------------------------
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_APR=y
# SND_SOC_QCOM is the menuconfig gate for every QDSP6 symbol below; without
# it they prune silently (snapshot47 kernel.config dropped all of them).
CONFIG_SND_SOC_QCOM=y
# SND_SOC_QDSP6 is the umbrella that selects CORE/AFE/ADM/ASM/ROUTING/APM/PRM
# (those leaves have no prompt; setting them directly is a no-op — snapshot48
# .config proved it). Deps QCOM_APR + COMMON_CLK both =y.
CONFIG_SND_SOC_QDSP6=y
# FastRPC userspace ABI (/dev/adsprpc-smd*): adsprpcd + sensors HAL need it;
# Q6V5_PAS above only loads the firmware. Deps satisfied (ARCH_QCOM, RPMSG).
CONFIG_QCOM_FASTRPC=y

# --- WWAN control (driver itself is still missing) -------------------------
CONFIG_QCOM_WCNSS_CTRL=y
CONFIG_BT_QCOMSMD=y
# SSR crash detection + graceful shutdown (without it a silent FW crash is
# invisible; ADSP/WCNSS come up but their deaths would leave no trace).
CONFIG_QCOM_SYSMON=y

# --- WLAN (WCN3680 via wcn36xx + pronto PIL) --------------------------------
# Stock live DT iris compatible is qcom,wcn3680 (covered by WCN36XX +
# qcom_wcnss_iris). Prima blobs in /vendor/firmware/wlan/prima/;
# wcnss.mdt/.bXX live on the modem partition and are NOT yet harvested,
# so pronto fails fast until staged; wcn36xx defers meanwhile.
# Two gates below are load-bearing; without them Kconfig silently resolves the
# whole chain to =m and merge_config reports success:
#   RFKILL=m (gki baseline) makes CFG80211's "depends on RFKILL || !RFKILL"
#   evaluate to m, capping CFG80211/MAC80211/WCN36XX at =m.
#   WLAN_VENDOR_ATH=n hides the whole `if WLAN_VENDOR_ATH` block in
#   drivers/net/wireless/ath/Kconfig, so WCN36XX is not a visible symbol.
CONFIG_RFKILL=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WCN36XX=y
CONFIG_QCOM_WCNSS_PIL=y

# --- board peripherals ------------------------------------------------------
CONFIG_LEDS_AW2013=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_SND_SOC_MAX98927=y

# --- display (mdss/mdp5/dsi0 + otm1911 panel) -------------------------------
# Tissot's panel is an Orise OTM1911 1080x1920 burst-video DSI panel
# (downstream dsi-pref-prim-pan). DRM_MSM pulls MDP5/DSI/14nm-PHY (all
# default y); the panel itself is drivers/gpu/drm/panel/panel-otm1911.c.
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_OTM1911=y

# --- qseecom (probe fix: shmbridge best-effort) ------------------------------
# Local drivers/misc/qseecom.c. Must stay built-in: the node-enabled boot
# proof (paste-2) and any qseecom test depend on it. gki_defconfig does not
# set it, so it lives here, not in the old .config.
CONFIG_QSEECOM=y

# --- ION (keymaster Trustlet memory) ----------------------------------------
# The vendor keymaster HAL (keystore.msm8953.so -> libQSEEComAPI.so) calls
# ion_open() at startup; without /dev/ion QSEECom_start_app fails and the
# service exits status 1 on every spawn, which stalls keystore2 and FBE
# (snapshot29). ION_LEGACY provides the legacy ioctl ABI this old userspace
# uses; SYSTEM/CMA heaps back the allocations (DMA_CMA is already enabled).
# STAGING is listed explicitly so the fragment stays sufficient on its own.
CONFIG_STAGING=y
CONFIG_ION=y
CONFIG_ION_LEGACY=y
CONFIG_ION_SYSTEM_HEAP=y
CONFIG_ION_CMA_HEAP=y

# --- fbcon (display proof) --------------------------------------------------
# Without fbdev emulation the kernel can never modeset: the panel would keep
# the stale bootloader frame until SurfaceFlinger commits. fbcon makes the
# kernel itself light the panel at boot, separating link/panel faults from
# userspace modeset faults.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_CORE=y
CONFIG_VT=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- selinux bootparam capability (no behavior change by itself) -------------
# Accepts selinux=0/1 on the cmdline. Without the token the default (enabled)
# applies, so this only ever matters for explicitly debug-labeled builds.
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
# --- debug ------------------------------------------------------------------
CONFIG_CRYPTO_DEV_QCOM_RNG=y
CONFIG_PANIC_ON_OOPS=y

# --- USB gadget / adb -------------------------------------------------------
# adbd speaks FunctionFS through the configfs ffs.adb function.
#   CONFIG_USB_CONFIGFS_F_FS selects CONFIG_USB_F_FS (6.12 gadget Kconfig).
# The legacy g_ffs gadget (CONFIG_USB_FUNCTIONFS) must stay off: built in, it
# claims the single FunctionFS device (g_ffs.c ffs_single_dev), so Android's
# mkdir functions/ffs.adb fails with EBUSY and adbd's mount binds to g_ffs,
# which then cannot find a UDC (snapshot46: "g_ffs: couldn't find an
# available UDC" on every adbd restart, no adb).
# CONFIG_USB_FUNCTIONFS is not set
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_F_FS=y
CONFIG_USB_U_SERIAL=y
# SERIAL_MSM_CONSOLE selects SERIAL_EARLYCON, so a console exists before the
# regular tty layer is up. The port is GENI serial, not HSL: the console name is
# ttyMSM0 (there is no SERIAL_MSM_HSL symbol in 6.12), so the command line is
# console=ttyMSM0,115200n8, which needs a 3.3V USB-TTL adapter on the board pads.
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_USB_U_SERIAL_CONSOLE=y
# Needed by the diagnostic initramfs: devtmpfs gives it /dev/kmsg and the block
# device nodes without hand-mknod'ing them. Android's own first-stage init does
# not need this, which is why it was absent from gki_defconfig's critical path.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_USB_CONFIGFS_ACM=y
# gser: the "Generic serial function". Like ACM this only appears once Android
# userspace creates the gadget in configfs, so it cannot report a stall that
# happens before init runs; it is here for later, once userspace is reachable.
CONFIG_USB_CONFIGFS_SERIAL=y

# --- QRTR (QMI transport) ---------------------------------------------------
# Vendor tftp_server opens AF_QIPCRTR sockets directly, and pm-service uses
# libqmi_cci, whose transport is QRTR (the donor 4.19 defconfig has QRTR=y,
# QRTR_SMD=y). Without it tftp_server, per_mgr and per_proxy exit 255/1 in a
# loop (snapshot46). QRTR_SMD carries it over the SMD rpmsg edges enabled
# above.
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y

# --- pstore on the logdump partition ---------------------------------------
# This is the only log channel that works before userspace exists, and the last
# six boot attempts produced no log at all without it.
#
# PSTORE_BLK_KMSG_SIZE is in KiB (fs/pstore/Kconfig:134, "Size in Kbytes"). The
# value used previously, 131072, meant 128 MiB against a 64 MiB partition
# (logdump is 131072 sectors of 512 B = 67,108,864 B), which the zone allocator
# cannot satisfy, so nothing was ever written. 32768 KiB = 32 MiB.
#
# The device must be named PARTLABEL=logdump on the kernel command line:
# early_boot_devpath() resolves it through block/early-lookup.c:248, and
# /dev/block/by-name/logdump does not exist yet at that point.
#
# PSTORE_RAM is enabled against a ramoops node relocated to 0x86800000, a 4 MiB
# System RAM hole that nothing else claims. The earlier "RAM does not survive the
# reset" conclusion came from a CAF pstore test whose ramoops sat at 0x91400000,
# which is Venus memory on this SoC, so that test never proved anything.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_BLK=y
CONFIG_PSTORE_BLK_KMSG_SIZE=32768
CONFIG_PSTORE_CONSOLE=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_ARM_SMMU=y
