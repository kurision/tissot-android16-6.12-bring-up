# SPDX-License-Identifier: GPL-2.0-only
#
# NOTE! Don't add files that are generated in specific
# subdirectories here. Add them in the ".gitignore" file
# in that subdirectory instead.
#
# NOTE! Please use 'git ls-files -i -c --exclude-per-directory=.gitignore'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#
# Normal rules (sorted alphabetically)
#
.*
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/kernel-release.yml
*.a
*.asn1.[ch]
*.bc
*.bin
*.bz2
*.c.[012]*.*
*.dt.yaml
*.dtb
*.dtbo
*.dtb.S
*.dtbo.S
*.dwo
*.elf
*.gcno
*.gcda
*.gz
*.i
*.ko
*.lex.c
*.ll
*.lst
*.lz4
*.lzma
*.lzo
*.mod
*.mod.c
*.o
*.o.*
*.patch
*.rmeta
*.rpm
*.rsi
*.s
*.so
*.so.dbg
*.su
*.symtypes
*.tab.[ch]
*.tar
*.xz
*.zst
Module.symvers
dtbs-list
modules.order

#
# Top-level generic files
#
/linux
/modules-only.symvers
/vmlinux
/vmlinux.32
/vmlinux.map
/vmlinux.symvers
/vmlinux-gdb.py
/vmlinuz
/System.map
/Module.markers
/modules.builtin
/modules.builtin.modinfo
/modules.builtin.ranges
/modules.nsdeps

#
# RPM spec file (make rpm-pkg)
#
/rpmbuild/

#
# Debian directory (make deb-pkg)
#
/debian/

#
# Snap directory (make snap-pkg)
#
/snap/

#
# tar directory (make tar*-pkg)
#
/tar-install/

#
# pacman files (make pacman-pkg)
#
/PKGBUILD
/pacman/

#
# We don't want to ignore the following even if they are dot-files
#
!.clang-format
!.clippy.toml
!.cocciconfig
!.editorconfig
!.get_maintainer.ignore
!.gitattributes
!.gitignore
!.kunitconfig
!.mailmap
!.rustfmt.toml

#
# Generated include files
#
/include/config/
/include/generated/
/arch/*/include/generated/

# stgit generated dirs
patches-*

# quilt's files
patches
series

# ctags files
tags
TAGS

# cscope files
cscope.*
ncscope.*

# gnu global files
GPATH
GRTAGS
GSYMS
GTAGS

# id-utils files
ID

*~
\#*#

#
# Leavings from module signing
#
extra_certificates
signing_key.pem
signing_key.priv
signing_key.x509
x509.genkey

# Kconfig presets
/all.config
/alldef.config
/allmod.config
/allno.config
/allrandom.config
/allyes.config

# Kconfig savedefconfig output
/defconfig

# Kdevelop4
*.kdev4

# Clang's compilation database file
/compile_commands.json

# Documentation toolchain
sphinx_*/

# Rust analyzer configuration
/rust-project.json

# bc language scripts (not LLVM bitcode)
!kernel/time/timeconst.bc

# Diagnostic boot artifacts: boot images and pulled evidence blobs are
# hundreds of megabytes and reproducible from porting/artifacts/snapshotNN/.
porting/artifacts/*.img
porting/artifacts/snapshot*/*.img
porting/artifacts/**/*.img
# WCNSS firmware and device NV calibration pulled from the device by
# porting/tools/pull-wcnss-firmware.sh; not redistributable.
porting/artifacts/firmware-wcnss/
# Venus video codec firmware pulled from the device by
# porting/tools/pull-venus-firmware.sh; not redistributable.
porting/artifacts/firmware-venus/
porting/artifacts/**/*.gz-dtb
porting/artifacts/**/kdir-*/
porting/artifacts/**/modules-*/
porting/artifacts/snapshot*/*.gz
porting/artifacts/snapshot*/base-ramdisk
porting/artifacts/snapshot*/Image.gz
porting/artifacts/snapshot*/init
porting/artifacts/snapshot*/daemon-probe-selftest-host
# Pulled evidence directories: logdump blobs and decoded text, tens of MB per
# run. The findings reports quote the measurements they contain.
porting/artifacts/snapshot*/logs-*/

# Keep only snapshot43 runs 10/11 capture evidence in repository history.
# Older captures remain local; reports retain their checked measurements.
porting/artifacts/**/*.log
porting/artifacts/**/*.status
porting/artifacts/**/*.stdout
porting/artifacts/**/*.stderr
porting/artifacts/dmesg-live.txt
porting/artifacts/failed-units.txt
porting/artifacts/snapshot*/run*-*.txt
!porting/artifacts/snapshot43/run10-*.log
!porting/artifacts/snapshot43/run11-*.log
!porting/artifacts/snapshot43/run10-*.status
!porting/artifacts/snapshot43/run11-*.status
!porting/artifacts/snapshot43/run10-logdump.bin
!porting/artifacts/snapshot43/run11-logdump.bin

# Bulk evidence stays local, same reasoning as the rules above. ANR traces,
# pulled sepolicy dumps and build outputs (vmlinux, System.map, Image.gz-dtb)
# are reproducible from one boot and together run to several hundred MB.
porting/artifacts/**/anr/
porting/artifacts/**/*-anr*/porting/artifacts/sepolicy/
porting/artifacts/**/vmlinux
porting/artifacts/**/System.map
porting/artifacts/**/*.tb
__pycache__/

# The port's own per-run evidence: the bulk of it is a boot image, a config
# dump, a 69k-file source manifest or a multi-megabyte logdump, and none of
# it is worth having in a changes list. The small records the port's
# convention commits (the package report, the ramoops recovery report, the
# build recipe, the summary) stay tracked; the rule below only covers the
# bulky generated siblings, and the tracked files are unaffected.
porting/artifacts/snapshot*/*-embedded.config
porting/artifacts/snapshot*/*-prebuild.config
porting/artifacts/snapshot*/*-source-verification.json
porting/artifacts/snapshot*/*-build-verification.json
porting/artifacts/snapshot*/*-usb-capture.out
porting/artifacts/snapshot*/*-host-experiment.out
porting/artifacts/snapshot*/*-adb-timeline.jsonl
porting/artifacts/snapshot*/*-boot-window.start
porting/artifacts/snapshot*/*-boot-window.end
porting/artifacts/snapshot*/*-base.sha256
porting/artifacts/snapshot*/*-config.diff
porting/artifacts/snapshot*/*-zap-stages.json
porting/artifacts/snapshot*/*-poll/
porting/artifacts/snapshot*/*-earlyhang/
porting/artifacts/snapshot*/run*-live/
porting/artifacts/snapshot*/run*-preboot/
porting/artifacts/snapshot*/run*-postboot/
porting/artifacts/snapshot*/run*-user-capture/
porting/artifacts/snapshot*/camera-*/
porting/artifacts/snapshot*/call-*/
porting/artifacts/snapshot*/failure-*/
# Boot images that landed in the repository root.
boot-run*.img

# ---------------------------------------------------------------------------
# Generated per-run evidence is not tracked.
#
# Everything the port produces while chasing the two remaining faults is
# generated evidence: a boot image, a logdump, a per-run JSON record, a
# config dump, a pulled blob or a capture stream. It is regenerated by the
# packaging tooling in the repository (scripts/stage-guard-inputs.py and
# porting/tools/), and together it runs to several gigabytes, so none of
# it belongs in a changes list.
#
# What stays tracked is the documentation under porting/ (the findings, the
# handoffs, the plan, the tracker, the reference notes and the *.md files
# that live inside the per-run directories) and the reusable tooling under
# porting/tools/.
#
# Nothing is lost: the old per-run records are still in the git history,
# and the boot images and the stock boot backup were moved to the archive
# directory outside this repository.
# ---------------------------------------------------------------------------

# Per-run record files: the packaging report, the ramoops recovery report,
# the capture output, the early logcat, the poll and observer streams and
# the built diag init.
porting/artifacts/**/package-run*.json
porting/artifacts/**/run*-ramoops.json
porting/artifacts/**/run*-capture.out
porting/artifacts/**/run*-early-logcat.log.*
porting/artifacts/**/results.json
porting/artifacts/**/poll.jsonl
porting/artifacts/**/observer.out
porting/artifacts/**/init-run*

# Per-run directories: the live capture, the preboot and postboot pulls,
# the poll directories, the early-hang captures, the user captures, the
# root audits, the stale pulls and the kernel build directories.
porting/artifacts/**/run*-live/
porting/artifacts/**/run*-preboot/
porting/artifacts/**/run*-postboot/
porting/artifacts/**/run*-poll/
porting/artifacts/**/run*-earlyhang/
porting/artifacts/**/run*-user-capture/
porting/artifacts/**/root-audit-*/
porting/artifacts/**/stale-*/
porting/artifacts/**/kdir-*/
porting/artifacts/**/modules-*/

# Bulk file types: boot images, logdumps, ramdisk and kernel blobs,
# screenshots and the raw capture streams.
porting/artifacts/**/*.bin
porting/artifacts/**/*.img
porting/artifacts/**/*.gz
porting/artifacts/**/*.png
porting/artifacts/**/*.jsonl
porting/artifacts/**/*.out

# The rest of the per-run namespace: every file and every directory whose
# name starts with a run number carries that run's record, whatever its
# suffix (the summary, the reset path, the host experiment, the poll
# script, the build recipe, the test directory).
porting/artifacts/**/run[0-9]*

# The per-run directories that carry no run number in their name: the live
# component audits, the Magisk payload, the ANR traces, the plain kernel
# build directory and the base images kept next to a boot image.
porting/artifacts/**/live-audit-*/
porting/artifacts/**/magisk-files/
porting/artifacts/**/anr/
porting/artifacts/**/anr-run*/
porting/artifacts/**/kdir/
porting/artifacts/**/*.apk
porting/artifacts/**/*.img.base

# The device property dumps and the packaging control record that belong
# to a panel probe or to a control run.
porting/artifacts/snapshot*/panel-*stock*.txt
porting/artifacts/**/package-control.json

# A local scratch build script at the repository root, not part of the
# porting tree.
/build_tissot.sh

# Generated porting captures and diagnostic output stay local.
/porting/artifacts/
/porting/logging/logs/
/porting/findings/*.log
/evidence/logs/
/evidence/serial/
/evidence/raw/
/evidence/manifest.json
/evidence/tissot-partitions.txt
/*.log
/data-recent.txt
/tombstones-and-today.txt
/tissot-snapshot15.config
